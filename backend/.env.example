# ==============================================================================
# Alibaba DashScope Embeddings
# ==============================================================================
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
USE_MOCK_EMBEDDINGS=false
DASHSCOPE_RPM_LIMIT=60

# ==============================================================================
# Alibaba Qwen LLM Generation
# ==============================================================================
LLM_API_KEY=sk-your-qwen-llm-key-here
LLM_BASE_URL=https://ws-lghtetahpb40cmex.us-east-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ==============================================================================
# Vector Databases
# ==============================================================================
POSTGRES_URL=postgresql://rag:rag@localhost:5432/ragdb
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ragdb

# ==============================================================================
# Security & Multi-Tenancy
# ==============================================================================
SECRET_KEY=change-this-in-production-to-a-very-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GUEST_SESSION_TTL_HOURS=24

# ==============================================================================
# Ingest Limits & Concurrency
# ==============================================================================
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_JOBS=3
CORS_ORIGINS=*
